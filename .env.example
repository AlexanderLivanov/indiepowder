# ─────────────────────────────────────────────────────────────
#  Пример переменных окружения. Скопируйте в .env и заполните.
#  Пустые значения → провайдер/база просто выключены (не ломается).
# ─────────────────────────────────────────────────────────────

# База. Если не задать — приложение работает в памяти (демо-вход demo / demo1234).
DATABASE_URL="mysql://root:@localhost:3306/dustorev3"

# Секрет сессии и подписи pending-токенов. Минимум 32 символа.
NUXT_SESSION_SECRET="смените-на-длинную-случайную-строку-32+"

# ── OAuth-вход ─────────────────────────────────────────────────
# Яндекс ID:  https://oauth.yandex.ru/client/new
#   Redirect URI:  <origin>/api/auth/oauth/yandex/callback
#   Права:         «Доступ к адресу почты», «Доступ к логину/имени»
NUXT_YANDEX_CLIENT_ID=""
NUXT_YANDEX_CLIENT_SECRET=""

# VK ID (классический OAuth):  https://vk.com/apps?act=manage
#   Redirect URI:  <origin>/api/auth/oauth/vk/callback
#   Права:         email
NUXT_VK_CLIENT_ID=""
NUXT_VK_CLIENT_SECRET=""

# Telegram Login Widget:  @BotFather → создать бота → /setdomain (домен сайта)
#   BOT_TOKEN  — секрет бота (проверка подписи на сервере)
#   BOT_NAME   — username бота без «@»
#   PUBLIC_*   — то же имя бота, но доступное в браузере (для виджета)
NUXT_TELEGRAM_BOT_TOKEN=""
NUXT_TELEGRAM_BOT_NAME=""
NUXT_PUBLIC_TELEGRAM_BOT=""

# Примечание про <origin>: в разработке это http://localhost:3000,
# в проде — адрес сайта (https://…). Redirect URI в кабинете провайдера
# должен совпадать с этим origin точно.
